@{
    Layout = "~/Views/Shared/_CraftsSystemLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Zacbel+X&display=swap" rel="stylesheet">

<style>
    body {
        background: #fffcfd;
        font-family: 'Poppins', sans-serif;
    }

    .custom-nav {
        background-color: #FFF0F5 !important;
        padding: 0 3rem;
        border-bottom-left-radius: 25px;
        border-bottom-right-radius: 25px;
        height: 80px;
        line-height: 80px;
        box-shadow: none;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 80px;
    }

    .nav-links-wrapper {
        display: flex;
        align-items: center;
        gap: 35px;
    }

    .nav-link-item {
        color: #f50057 !important;
        font-weight: 500;
        text-decoration: none;
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        position: relative;
        transition: all 0.3s ease;
        padding-bottom: 5px;
    }

        .nav-link-item:hover {
            opacity: 0.7;
        }

        .nav-link-item::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #f50057;
            transition: width 0.3s ease;
        }

        .nav-link-item:hover::after {
            width: 100%;
        }

    .active-link::after {
        width: 100% !important;
    }

    .logout-btn {
        border-radius: 20px;
        font-weight: 500;
        text-transform: none;
        height: 40px;
        line-height: 40px;
        background-color: #f06292 !important;
        transition: background-color 0.3s ease, transform 0.2s ease !important;
    }

        .logout-btn:hover {
            background-color: #f50057 !important;
            transform: scale(1.05);
        }

    .hero-container {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10vh 10%;
        gap: 60px;
    }

    .hero-image-wrapper {
        position: relative;
        z-index: 1;
    }

        .hero-image-wrapper::after {
            content: '';
            position: absolute;
            top: 20px;
            left: 20px;
            width: 100%;
            height: 100%;
            border: 3px solid #f50057;
            border-radius: 30px;
            z-index: -1;
        }

    .main-hero-img {
        width: 420px;
        border-radius: 30px;
        box-shadow: 0 20px 40px rgba(245, 0, 87, 0.15);
        display: block;
        transition: transform 0.5s ease;
    }

    .btn-explore {
        background: #f50057;
        color: white;
        padding: 18px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        box-shadow: 0 8px 20px rgba(245, 0, 87, 0.4);
        transition: 0.3s ease;
        border: none;
        display: inline-block;
        text-decoration: none;
    }

        .btn-explore:hover {
            background: #ff1a6b;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(245, 0, 87, 0.5);
            color: white;
        }

    .bg-shape {
        position: absolute;
        background: #fff0f5;
        border-radius: 50%;
        filter: blur(80px);
        z-index: -2;
    }
</style>

<div ng-app="" ng-init="section='home'">

    <nav class="custom-nav">
        <div class="nav-container">
            <a href="@Url.Action("Homepage","CraftSystem")">
                <img src="@Url.Content("~/Content/images/logo1.png")" alt="Logo" style="height:55px;">
            </a>

            <div class="nav-links-wrapper">
                <a href="@Url.Action("Homepage","CraftSystem")" class="nav-link-item active-link">Home</a>
                <a href="@Url.Action("AboutPage","CraftSystem")" class="nav-link-item">About</a>
                <a href="@Url.Action("ArtisanPage","CraftSystem")" class="nav-link-item">Artisan Page</a>

                <a href="@Url.Action("LogInPage","CraftSystem")"
                   class="waves-effect waves-light btn logout-btn">
                    Logout
                </a>
            </div>
        </div>
    </nav>

    <div ng-show="section=='home'" style="position: relative; overflow: hidden; min-height: 80vh;">
        <div class="bg-shape" style="width: 500px; height: 500px; top: -150px; right: -100px; background: #fff0f5;"></div>
        <div class="bg-shape" style="width: 400px; height: 400px; bottom: -100px; left: -100px; background: #ffe4ec;"></div>

        <div class="hero-container">
            <div class="hero-image-wrapper">
                <img src="@Url.Content("~/Content/Images/customcharacdesign.jpg")" class="main-hero-img" />
                <div style="position: absolute; bottom: -25px; left: -25px; background: #f50057; color: white; padding: 15px 25px; border-radius: 20px; box-shadow: 0 10px 20px rgba(245, 0, 87, 0.2);">
                    <span style="font-weight: 600; display: block; font-size: 18px;">100% Local</span>
                    <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Filipino Artistry</span>
                </div>
            </div>

            <div style="max-width: 580px;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px;">
                    <div style="width: 40px; height: 2px; background: #f50057;"></div>
                    <span style="color: #f50057; font-weight: 600; letter-spacing: 2px; font-size: 13px; text-transform: uppercase;">
                        Handmade with Heart
                    </span>
                </div>

                <h1 style="font-family:'Zacbel X', sans-serif; color:#2d2d2d; font-size: 68px; margin: 0 0 20px 0; line-height: 1.1;">
                    Crafted by <br /><span style="color: #f50057;">Filipinos</span>
                </h1>

                <p style="color:#555; font-size:18px; line-height:1.8; margin-bottom: 40px; font-weight: 300;">
                    Welcome to <span style="color:#f50057; font-weight:600;">MoonlightCraft</span>. We bring together the finest artisans
                    from across the Philippines to share their passion, culture, and unique handmade creations with you.
                </p>

                <div style="display: flex; gap: 25px; align-items: center;">
                    <a href="@Url.Action("ArtisanPage","CraftSystem")" class="btn-explore">
                        Explore Collection
                    </a>
                    <a href="@Url.Action("AboutPage","CraftSystem")" style="color: #f50057; font-weight: 600; border-bottom: 2px solid #f50057; text-decoration: none; padding-bottom: 5px;">
                        Learn Our Story
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer style="background: linear-gradient(135deg, #f50057 0%, #d8004d 100%); color: white; padding: 5rem 0 2rem 0; border-top-left-radius: 60px; border-top-right-radius: 60px;">
        <div class="container">
            <div class="row">
                <div class="col s12 m4">
                    <h5 style="font-family:'Zacbel X', sans-serif; margin-bottom: 20px;">MoonlightCraft</h5>
                    <p style="opacity: 0.9; font-size: 14px; font-weight: 300; line-height: 1.8;">
                        Supporting Filipino artisans by providing a platform for their unique,
                        handcrafted masterpieces. Proudly local.
                    </p>
                </div>
                <div class="col s12 m4">
                    <h6 style="font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px;">Contact</h6>
                    <p style="font-size: 14px; opacity: 0.9; line-height: 2;">
                        <i class="material-icons" style="font-size: 16px; vertical-align: middle; margin-right: 8px;">email</i> moonlightcraft@gmail.com<br>
                        <i class="material-icons" style="font-size: 16px; vertical-align: middle; margin-right: 8px;">location_on</i> Cavite, Philippines
                    </p>
                </div>
                <div class="col s12 m4">
                    <h6 style="font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px;">Join Us</h6>
                    <p style="font-size: 14px; opacity: 0.9;">Follow our journey and discover the latest creations from our talented artists.</p>
                </div>
            </div>
            <div class="center-align" style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.2); font-size: 12px; opacity: 0.7;">
                &copy; 2026 MoonlightCraft. All Rights Reserved.
            </div>
        </div>
    </footer>
</div>