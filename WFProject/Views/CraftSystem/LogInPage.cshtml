@{
    Layout = "~/Views/Shared/_CraftsSystemLayout.cshtml";
}

<div class="container" style="margin-top: 8vh; margin-bottom: 5vh;">
    <div class="row">
        <div class="col s12 m10 l8 offset-m1 offset-l2">

            <div class="row z-depth-3 login-card"
                 style="border-radius:30px; overflow:hidden; display:flex; flex-wrap:wrap; background-color:#ffffff; min-height: 550px; box-shadow: 0 15px 35px rgba(0,0,0,0.1);">

                <div class="col s12 m5 hide-on-small-only"
                     style="position:relative;
                            background-image: url(@Url.Content("~/Content/Images/ceramicpink.jpg"));
                            background-size: cover;
                            background-position: center;
                            padding: 0;">

                    <div style="position:absolute; top:0; left:0; width:100%; height:100%; background: rgba(255,182,193,0.35);"></div>

                    <div style="position: absolute; bottom: 10%; left: 10%; color: white; text-shadow: 1px 1px 5px rgba(0,0,0,0.2);">
                        <h5 style="font-family:'Zacbel X', sans-serif; margin: 0;">Handmade</h5>
                        <p style="margin: 0; font-weight: 300; letter-spacing: 1px;">Support Local Artists</p>
                    </div>
                </div>

                <div class="col s12 m7" style="padding: 2.5rem 2.5rem; display:flex; flex-direction:column; justify-content:center;">

                    <div class="center-align" style="margin-bottom: 1rem;">
                        <img src="@Url.Content("~/Content/images/logo1.png")" alt="MoonlightCraft Logo"
                             style="width: 100%; max-width: 220px; height: auto;">
                    </div>

                    <h2 style="font-family:'Zacbel X', sans-serif; color:#f50057; margin-top: 0; margin-bottom:2rem; text-align:center; font-size: 2.5rem; letter-spacing: 1px;">
                        LOG-IN
                    </h2>

                    <form name="loginForm" novalidate>

                        <div class="row" style="margin-bottom: 15px;">
                            <div class="input-field col s12">
                                <i class="material-icons prefix" style="color:#FF69B4;">account_circle</i>
                                <input id="loginUsername"
                                       type="text"
                                       name="loginUsername"
                                       ng-model="loginUser"
                                       ng-pattern="/^[a-zA-Z0-9]{6,15}$/"
                                       required
                                       style="border-bottom: 1px solid #FFC1E3;">
                                <label for="loginUsername">Username</label>

                                <div style="margin-left: 3rem;">
                                    <span class="red-text" style="font-size: 11px;"
                                          ng-show="submitted && loginForm.loginUsername.$error.required">
                                        Username is required
                                    </span>
                                    <span class="red-text" style="font-size: 11px;"
                                          ng-show="loginForm.loginUsername.$dirty && loginForm.loginUsername.$error.pattern">
                                        Must be 6-15 letters or numbers
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 25px;">
                            <div class="input-field col s12">
                                <i class="material-icons prefix" style="color:#FF69B4;">lock</i>
                                <input id="loginPassword"
                                       type="password"
                                       name="loginPassword"
                                       ng-model="loginPassword"
                                       ng-minlength="6"
                                       ng-maxlength="20"
                                       required
                                       style="border-bottom: 1px solid #FFC1E3;">
                                <label for="loginPassword">Password</label>

                                <div style="margin-left: 3rem;">
                                    <span class="red-text" style="font-size: 11px;"
                                          ng-show="submitted && loginForm.loginPassword.$error.required">
                                        Password is required
                                    </span>
                                    <span class="red-text" style="font-size: 11px;"
                                          ng-show="loginForm.loginPassword.$dirty && (loginForm.loginPassword.$error.minlength || loginForm.loginPassword.$error.maxlength)">
                                        Password must be 6-20 characters
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="row center-align">
                            <button type="button"
                                    class="waves-effect waves-light btn-large pink accent-3"
                                    style="border-radius:30px; width:100%; font-weight: bold; box-shadow: 0 4px 15px rgba(245, 0, 87, 0.3);"
                                    ng-click="loginFunc()"
                                    ng-disabled="loginForm.$invalid">
                                LOG-IN
                            </button>
                        </div>

                        <div class="center-align" style="margin-top: 1.5rem;">
                            <p style="color: #888; font-size: 0.9rem;">
                                Don't have an account?
                                <a href="@Url.Action("Registration", "CraftSystem")"
                                   style="color: #f50057; font-weight: 600; text-decoration: none; border-bottom: 1px solid #f50057;">
                                    Register Here
                                </a>
                            </p>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .input-field input:focus + label {
        color: #f50057 !important;
    }

    .input-field input:focus {
        border-bottom: 2px solid #f50057 !important;
        box-shadow: none !important;
    }

    .btn-large:hover {
        transform: translateY(-2px);
        transition: 0.2s ease;
    }
</style>