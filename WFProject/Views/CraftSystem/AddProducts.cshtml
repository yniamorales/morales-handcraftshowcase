@{
    if (Session["UserRole"] == null || Session["UserRole"].ToString().ToLower() != "artisan")
    {
        Response.Redirect("~/CraftSystem/LogInPage");
    }
    ViewBag.Title = "Add New Craft";
    Layout = "~/Views/Shared/_CraftsSystemLayout.cshtml";
}

<style>
    .sidebar {
        background: #f50057;
        height: 100vh;
        padding: 1.5rem 0;
        position: relative;
    }

        .sidebar h5 {
            font-family: 'Zacbel X';
            text-align: center;
            color: white;
            margin-bottom: 2rem;
        }

        .sidebar ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .sidebar a {
            color: white !important;
            font-weight: 500;
            display: block;
            padding: 12px 20px;
            margin: 5px 15px;
            border-radius: 10px;
            transition: 0.2s;
            text-decoration: none;
        }

            .sidebar a:hover, .sidebar a.active {
                background: rgba(255,255,255,0.2);
            }

    .main-bg {
        background: #FFF0F5;
        min-height: 100vh;
        padding: 2rem;
    }

    .form-card {
        border-radius: 25px;
        padding: 2.5rem;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .preview-box {
        width: 100%;
        height: 300px;
        border: 2px dashed #ff80ab;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 1rem;
        background: #fdf2f5;
    }

        .preview-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
        }

    .fixed-textarea {
        height: 140px !important;
        overflow-y: auto !important;
        padding: 12px !important;
        border: 1px solid #FFC1E3 !important;
        border-radius: 15px !important;
        resize: none !important;
        background-color: #fffafc !important;
        box-sizing: border-box !important;
        margin-top: 10px !important;
    }

    .input-field .prefix {
        top: 1rem !important;
        color: #f50057;
    }

    .input-field label.active {
        transform: translateY(-25px) scale(0.8) !important;
        color: #f50057 !important;
        font-weight: bold;
    }

    .save-btn {
        border-radius: 25px;
        background: #f50057 !important;
        padding: 0 2rem;
        font-weight: bold;
    }

    .cancel-btn {
        color: #888;
        margin-right: 1rem;
        text-transform: uppercase;
        font-weight: 500;
    }


    .fixed-textarea::-webkit-scrollbar {
        width: 6px;
    }

    .fixed-textarea::-webkit-scrollbar-thumb {
        background-color: #ff80ab;
        border-radius: 10px;
    }
</style>

<div class="row" style="margin:0;" ng-controller="CraftSystem" ng-init="loadProfile()">

    <div class="col s12 m3 l2 sidebar">
        <h5 style="font-size: 1.2rem;">{{artisanProfile.artisanName || 'Loading...'}}</h5>
        <ul>
            <li><a href="/CraftSystem/ArtisanDB">My Dashboard</a></li>
            <li><a href="/CraftSystem/AddProducts" class="active">Add New Craft</a></li>
        </ul>
        <div style="position: absolute; bottom: 20px; width: 100%;">
            <a href="/CraftSystem/ArtisanProfile" style="margin: 5px 15px;"><i class="material-icons left">person</i> My Profile</a>
            <a href="/CraftSystem/Logout" style="margin: 5px 15px;"><i class="material-icons left">exit_to_app</i> Logout</a>
        </div>
    </div>

    <div class="col s12 m9 l10 main-bg">
        <div class="container">
            <h4 style="font-family:'Zacbel X'; color:#f50057; font-weight:bold;">List Your Creation 🎨</h4>
            <p style="color: #d81b60; font-weight: 500;">Provide the details for your new craft below.</p>

            <div class="row" style="margin-top: 2rem;">
                <div class="col s12 l10 offset-l1">
                    <div class="form-card">
                        <form name="addCraftForm">
                            <div class="row">
                                <div class="col s12 m5">
                                    <label style="font-size: 1rem; color: #f50057; font-weight: 600;">Craft Preview</label>
                                    <div class="preview-box">
                                        <i class="material-icons" style="font-size: 4rem; color: #ff80ab;" id="placeholderIcon">image</i>
                                        <img id="previewImg" src="#" style="display:none;" />
                                    </div>

                                    <div class="file-field input-field">
                                        <div class="btn pink lighten-3" style="width: 100%; border-radius: 15px;">
                                            <span>Select Photo</span>
                                            <input type="file" id="imageUpload" onchange="previewImage(this)">
                                        </div>
                                        <div class="file-path-wrapper">
                                            <input class="file-path validate" type="text" placeholder="Upload image">
                                        </div>
                                    </div>
                                </div>

                                <div class="col s12 m7">
                                    <div class="input-field">
                                        <i class="material-icons prefix">palette</i>
                                        <input id="prod_name"
                                               type="text"
                                               ng-model="newCraft.ProductName"
                                               maxlength="50"
                                               required>
                                        <label for="prod_name">Craft Name</label>

                                        <div class="right-align">
                                            <span style="font-size: 10px; color: #9e9e9e;">
                                                {{newCraft.ProductName.length || 0}} / 50
                                            </span>
                                        </div>
                                    </div>

                                    <div class="input-field" style="margin-top: 2rem;">
                                        <i class="material-icons prefix">description</i>
                                        <textarea id="prod_desc"
                                                  class="fixed-textarea"
                                                  ng-model="newCraft.ProductDesc"
                                                  maxlength="500"
                                                  style="height: 180px !important;"
                                                  placeholder="Tell the story of your craft..."></textarea>
                                        <label for="prod_desc" class="active">Detailed Description & Socials</label>

                                        <div class="right-align">
                                            <span style="font-size: 11px; font-weight: bold; color: #f50057;">
                                                {{newCraft.ProductDesc.length || 0}} / 500
                                            </span>
                                        </div>
                                    </div>

                                    <div class="center-align" style="margin-top: 2rem;">
                                        <a href="/CraftSystem/ArtisanDB" class="cancel-btn">Cancel</a>
                                        <button type="button"
                                                class="btn btn-large save-btn waves-effect waves-light"
                                                ng-click="submitCraft()"
                                                ng-disabled="!newCraft.ProductName || !newCraft.ProductDesc || !artisanProfile.ArtisanId">
                                            Publish Craft
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#previewImg').attr('src', e.target.result).show();
                $('#placeholderIcon').hide();
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    $(document).ready(function () {
        const scope = angular.element(document.querySelector('[ng-controller="CraftSystem"]')).scope();
        if (scope) {
            scope.$apply(function () {
                scope.loadProfile();
            });
        }

        if (typeof M !== 'undefined') {
            M.updateTextFields();
        }
    });
</script>