@{
    if (Session["UserRole"] == null || Session["UserRole"].ToString().ToLower() != "artisan")
    {
        Response.Redirect("~/CraftSystem/LogInPage");
    }
    Layout = "~/Views/Shared/_CraftsSystemLayout.cshtml";
}

<style>
    .sidebar {
        background: #f50057;
        height: 100vh;
        padding: 1.5rem 0;
        position: relative;
    }

        .sidebar h5 {
            font-family: 'Zacbel X';
            text-align: center;
            color: white;
            margin-bottom: 2rem;
        }

        .sidebar ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .sidebar a {
            color: white !important;
            font-weight: 500;
            display: block;
            padding: 12px 20px;
            margin: 5px 15px;
            border-radius: 10px;
            transition: 0.2s;
            text-decoration: none;
        }

            .sidebar a:hover, .sidebar a.active {
                background: rgba(255,255,255,0.2);
            }

    .main-bg {
        background: #FFF0F5;
        min-height: 100vh;
        padding: 2rem;
    }

    .dashboard-card {
        border-radius: 20px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.08);
    }

    .table-card {
        border-radius: 20px;
        padding: 1rem;
        background: white;
    }

    .add-btn {
        border-radius: 20px;
        background: #f50057 !important;
    }
</style>

<div class="row" style="margin:0;" ng-controller="CraftSystem" ng-init="loadCrafts(); loadProfile();">

    <div class="col s12 m3 l2 sidebar">
        <h5 style="font-size: 1.2rem;">{{artisanProfile.artisanName || 'Loading...'}}</h5>

        <ul>
            <li><a href="/CraftSystem/ArtisanDB" class="active">My Dashboard</a></li>
            <li><a href="/CraftSystem/AddProducts">Add New Craft</a></li>
        </ul>

        <div style="position: absolute; bottom: 20px; width: 100%;">
            <div style="padding: 0 15px;">
                <hr style="border: 0.5px solid rgba(255,255,255,0.2); margin-bottom: 1rem;">
            </div>
            <a href="/CraftSystem/ArtisanProfile">
                <i class="material-icons left">person</i> My Profile
            </a>
            <a href="/CraftSystem/Logout">
                <i class="material-icons left">exit_to_app</i> Logout
            </a>
        </div>
    </div>


    <div class="col s12 m9 l10 main-bg">

        <h4 style="font-family:'Zacbel X'; color:#f50057; font-weight:bold;">
            My Crafts 🎨
        </h4>

        <div class="row">
            <div class="col s12 m6 l3">
                <div class="card pink lighten-3 white-text center-align dashboard-card">
                    <div class="card-content">
                        <h5>{{craftsInfo.length || 0}}</h5>
                        <p>Total Crafts</p>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-bottom:1.5rem;">
            <a href="/CraftSystem/AddProducts" class="btn add-btn waves-effect waves-light">
                + Add New Craft
            </a>
        </div>

        <div class="card table-card">
            <div class="card-content">
                <table class="striped responsive-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Craft Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="craftData in craftsInfo">
                            <td>
                                <img ng-src="{{craftData.ProductImgUrl}}" style="width:70px; height:70px; object-fit:cover; border-radius:10px;">
                            </td>
                            <td>{{craftData.ProductName}}</td>
                            <td>{{craftData.ProductDesc}}</td>
                            <td>
                                <span class="badge white-text"
                                      ng-class="craftData.ProductStatus.toLowerCase() == 'pending' ? 'orange' : 'green'"
                                      style="border-radius:10px; float:none;">
                                    {{craftData.ProductStatus}}
                                </span>
                            </td>
                            <td>
                                <button class="btn-floating blue waves-effect waves-light"
                                        ng-click="editCraft(craftData)">
                                    <i class="material-icons">edit</i>
                                </button>

                                <button class="btn-floating red waves-effect waves-light"
                                        ng-click="removeCraft(craftData.ProductId)">
                                    <i class="material-icons">delete</i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>